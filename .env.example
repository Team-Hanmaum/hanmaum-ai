# Local-only settings. Copy to .env; never commit real credentials.
APP_ENV=local
AI_PROVIDER=stub
# Must match the Spring backend's AI_INTERNAL_API_KEY for local integration.
AI_INTERNAL_API_KEY=local-development-only
ANALYSIS_TIMEOUT_SECONDS=20

# v2 is opt-in and independent of the v1 provider above. No real LLM adapter yet.
AI_V2_PROVIDER=disabled
# To enable the local/test stub, explicitly provision a persistent SQLite file first.
# See README: v2 HTTP 실행. Never regenerate missing keys or a lost receipt store.
# AI_V2_RECEIPT_DB_PATH=C:/dev/Hanmaum/ai-data/receipts.sqlite3
# AI_V2_ACTIVE_HMAC_KEY_VERSION=local-1
# AI_V2_HMAC_KEYS={"local-1":"<separately generated secret of at least 32 bytes>"}
# Keep historic keys while their receipts exist. Never reuse AI_INTERNAL_API_KEY.
AI_V2_PROVIDER_TIMEOUT_SECONDS=20
AI_V2_TOTAL_TIMEOUT_SECONDS=26
AI_V2_BODY_TIMEOUT_SECONDS=2
AI_V2_WORKER_TIMEOUT_SECONDS=1
AI_V2_STORE_LOCK_TIMEOUT_SECONDS=0.25
