# Documentation only. Actions generates runtime.env from production Secrets/Variables.
# This file is NOT loaded automatically. No real values belong in the repository.
APP_ENV=prod
AI_PROVIDER=disabled
AI_V2_PROVIDER=openai
AI_INTERNAL_API_KEY=<same-existing-BE-key>
OPENAI_API_KEY=<AI-only-provider-key>
AI_V2_RECEIPT_DB_PATH=/var/lib/hanmaum-ai/receipts.sqlite3
AI_V2_HMAC_KEYS={"prod-1":"<separate-random-key-at-least-32-bytes>"}
AI_V2_ACTIVE_HMAC_KEY_VERSION=prod-1
AI_V2_MODEL=gpt-6-luna
AI_V2_REASONING_EFFORT=low
AI_V2_SERVICE_TIER=default
AI_V2_MAX_OUTPUT_TOKENS=4096
